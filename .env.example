# ShutterStorm settings. Copy to .env (git-ignored) and fill in.
# Immich's own settings (DB password etc.) live in immich/.env, created by `make immich-fetch`.

# Immich release to fetch and run. Pinned; never "latest".
IMMICH_VERSION=v3.3.1

# Where ShutterStorm reaches Immich (localhost only; anything else is refused).
IMMICH_URL=http://127.0.0.1:2283
# API key for the sandbox admin. Filled in automatically by `make bootstrap`.
IMMICH_API_KEY=

# LLM (optional: without a key the tool runs on deterministic fallbacks).
# One variable per value; no commas, no spaces, no quotes needed.
LLM_PROVIDER=mistral
# The base URL only: NOT .../chat/completions and no trailing slash.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
# large = decisions (the experiment planner); small = analysis and report writing.
# Check what your key can actually use with: shutterstorm llm-check
# (quotas are per model; some "latest" aliases may be unavailable on a given plan).
LLM_MODEL_LARGE=ministral-14b-latest
LLM_MODEL_SMALL=ministral-8b-latest
